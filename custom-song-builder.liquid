{{ 'custom-song-builder.css' | asset_url | stylesheet_tag }}

<script>
  window.Shopify = window.Shopify || {};
  window.Shopify.money_format = {{ shop.money_format | json }};
  window.Shopify.money_with_currency_format = {{ shop.money_with_currency_format | json }};
  window.Shopify.currency = window.Shopify.currency || {};
  window.Shopify.currency.active = {{ cart.currency.iso_code | json }};
  window.Shopify.currency.symbol = {{ cart.currency.symbol | json }};
  window.Shopify.country = {{ localization.country.iso_code | json }};
</script>

{%- liquid
  assign brand_color = section.settings.brand_color | default: '#ff5b00'
  assign heading_text = section.settings.heading | default: 'Create Your Custom Song'
  assign subheading_text = section.settings.subheading

  assign std_product = all_products['unlock-song-standard']
  assign pro_product = all_products['unlock-song-pro']
  assign pkg3_product = all_products['pro-song-bundle']
  if pkg3_product == blank
    assign pkg3_product = all_products['unlock-pro-spotify-apple-music']
  endif
  if pkg3_product == blank
    assign pkg3_product = all_products['spotify-apple-music']
  endif

  if std_product == blank or pro_product == blank or pkg3_product == blank
    for p in collections.all.products
      if p.title contains 'Standard' or p.handle contains 'standard'
        if std_product == blank
          assign std_product = p
        endif
      elsif p.title contains 'Unlock Song - Pro' or p.handle == 'unlock-song-pro'
        if pro_product == blank
          assign pro_product = p
        endif
      elsif p.title contains 'Pro Song Bundle' or p.handle contains 'bundle'
        if pkg3_product == blank
          assign pkg3_product = p
        endif
      elsif p.title contains 'Spotify & Apple Music' or p.title contains 'Music on All Platforms' or p.handle contains 'spotify'
        if pkg3_product == blank
          assign pkg3_product = p
        endif
      endif
    endfor
  endif

  if std_product == blank
    assign std_product = product | default: collections.all.products.first
  endif
  if pro_product == blank
    assign pro_product = product | default: collections.all.products[1] | default: collections.all.products.last
  endif

  assign std_default_v = std_product.selected_or_first_available_variant
  assign std_rush_v = blank
  if std_product != blank
    for v in std_product.variants
      assign v_title_lower = v.title | downcase
      if v_title_lower contains 'rush' or v_title_lower contains 'fast' or v_title_lower contains '60'
        assign std_rush_v = v
        break
      endif
    endfor
    if std_rush_v == blank and std_product.variants.size > 1
      assign std_rush_v = std_product.variants[1]
    endif
  endif

  assign pro_default_v = pro_product.selected_or_first_available_variant
  assign pro_rush_v = blank
  if pro_product != blank
    for v in pro_product.variants
      assign v_title_lower = v.title | downcase
      if v_title_lower contains 'rush' or v_title_lower contains 'fast' or v_title_lower contains '60'
        assign pro_rush_v = v
        break
      endif
    endfor
    if pro_rush_v == blank and pro_product.variants.size > 1
      assign pro_rush_v = pro_product.variants[1]
    endif
  endif

  assign pkg3_default_v = blank
  assign pkg3_rush_v = blank
  if pkg3_product != blank
    assign pkg3_default_v = pkg3_product.selected_or_first_available_variant
    for v in pkg3_product.variants
      assign v_title_lower = v.title | downcase
      if v_title_lower contains 'rush' or v_title_lower contains 'fast' or v_title_lower contains '60'
        assign pkg3_rush_v = v
        break
      endif
    endfor
    if pkg3_rush_v == blank and pkg3_product.variants.size > 1
      assign pkg3_rush_v = pkg3_product.variants[1]
    endif
  endif
-%}

<div
  class="csb-wrapper"
  id="csb-{{ section.id }}"
  data-section-id="{{ section.id }}"
  data-backend-url="{{ section.settings.backend_url | default: 'YOUR_BACKEND_URL' }}"
  data-product-id="{{ std_product.id }}"
  data-variant-id="{{ std_default_v.id }}"
  data-product-handle="{{ std_product.handle }}"
  data-rush-variant-id="{% if std_rush_v != blank %}{{ std_rush_v.id }}{% endif %}"
  data-error-genre="{{ section.settings.style_genre_error | default: 'Please select a genre to continue.' | escape }}"
  data-error-voice="{{ section.settings.style_voice_error | default: 'Please select a voice to continue.' | escape }}"
  data-error-mood="{{ section.settings.style_mood_error | default: 'Please select a mood to continue.' | escape }}"
  style="--csb-brand: {{ brand_color }};"
>
  <div class="csb-card">
    <script type="application/json" data-csb-variant-prices-json>
      {
        "variants": {
          {%- assign first_v = true -%}
          {%- if std_product != blank -%}
            {%- for v in std_product.variants -%}
              {%- unless first_v -%},{%- endunless -%}
              "{{ v.id }}": {
                "title": {{ v.title | json }},
                "price": {{ v.price | json }},
                "compare_at_price": {{ v.compare_at_price | json }},
                "formatted_price": {{ v.price | money | json }},
                "formatted_compare_at": {%- if v.compare_at_price > v.price -%}{{ v.compare_at_price | money | json }}{%- else -%}""{%- endif -%}
              }
              {%- assign first_v = false -%}
            {%- endfor -%}
          {%- endif -%}
          {%- if pro_product != blank -%}
            {%- for v in pro_product.variants -%}
              {%- unless first_v -%},{%- endunless -%}
              "{{ v.id }}": {
                "title": {{ v.title | json }},
                "price": {{ v.price | json }},
                "compare_at_price": {{ v.compare_at_price | json }},
                "formatted_price": {{ v.price | money | json }},
                "formatted_compare_at": {%- if v.compare_at_price > v.price -%}{{ v.compare_at_price | money | json }}{%- else -%}""{%- endif -%}
              }
              {%- assign first_v = false -%}
            {%- endfor -%}
          {%- endif -%}
          {%- if pkg3_product != blank -%}
            {%- for v in pkg3_product.variants -%}
              {%- unless first_v -%},{%- endunless -%}
              "{{ v.id }}": {
                "title": {{ v.title | json }},
                "price": {{ v.price | json }},
                "compare_at_price": {{ v.compare_at_price | json }},
                "formatted_price": {{ v.price | money | json }},
                "formatted_compare_at": {%- if v.compare_at_price > v.price -%}{{ v.compare_at_price | money | json }}{%- else -%}""{%- endif -%}
              }
              {%- assign first_v = false -%}
            {%- endfor -%}
          {%- endif -%}
        },
        "package_variants": {
          "standard": {
            "default_id": {{ std_default_v.id | json }},
            "default_price": {{ std_default_v.price | json }},
            "default_compare_at": {{ std_default_v.compare_at_price | json }},
            "formatted_default_price": {{ std_default_v.price | money | json }},
            "formatted_default_compare_at": {%- if std_default_v.compare_at_price > std_default_v.price -%}{{ std_default_v.compare_at_price | money | json }}{%- else -%}""{%- endif -%}
            {%- if std_rush_v != blank -%}
            ,"rush_id": {{ std_rush_v.id | json }},
            "rush_price": {{ std_rush_v.price | json }},
            "rush_compare_at": {{ std_rush_v.compare_at_price | json }},
            "formatted_rush_price": {{ std_rush_v.price | money | json }},
            "formatted_rush_compare_at": {%- if std_rush_v.compare_at_price > std_rush_v.price -%}{{ std_rush_v.compare_at_price | money | json }}{%- else -%}""{%- endif -%}
            {%- else -%}
            ,"rush_id": null,
            "rush_price": null,
            "formatted_rush_price": ""
            {%- endif -%}
          },
          "pro": {
            "default_id": {{ pro_default_v.id | json }},
            "default_price": {{ pro_default_v.price | json }},
            "default_compare_at": {{ pro_default_v.compare_at_price | json }},
            "formatted_default_price": {{ pro_default_v.price | money | json }},
            "formatted_default_compare_at": {%- if pro_default_v.compare_at_price > pro_default_v.price -%}{{ pro_default_v.compare_at_price | money | json }}{%- else -%}""{%- endif -%}
            {%- if pro_rush_v != blank -%}
            ,"rush_id": {{ pro_rush_v.id | json }},
            "rush_price": {{ pro_rush_v.price | json }},
            "rush_compare_at": {{ pro_rush_v.compare_at_price | json }},
            "formatted_rush_price": {{ pro_rush_v.price | money | json }},
            "formatted_rush_compare_at": {%- if pro_rush_v.compare_at_price > pro_rush_v.price -%}{{ pro_rush_v.compare_at_price | money | json }}{%- else -%}""{%- endif -%}
            {%- else -%}
            ,"rush_id": null,
            "rush_price": null,
            "formatted_rush_price": ""
            {%- endif -%}
          }
          {%- if pkg3_product != blank -%}
          ,"pkg3": {
            "default_id": {{ pkg3_default_v.id | json }},
            "default_price": {{ pkg3_default_v.price | json }},
            "default_compare_at": {{ pkg3_default_v.compare_at_price | json }},
            "formatted_default_price": {{ pkg3_default_v.price | money | json }},
            "formatted_default_compare_at": {%- if pkg3_default_v.compare_at_price > pkg3_default_v.price -%}{{ pkg3_default_v.compare_at_price | money | json }}{%- else -%}""{%- endif -%}
            {%- if pkg3_rush_v != blank -%}
            ,"rush_id": {{ pkg3_rush_v.id | json }},
            "rush_price": {{ pkg3_rush_v.price | json }},
            "rush_compare_at": {{ pkg3_rush_v.compare_at_price | json }},
            "formatted_rush_price": {{ pkg3_rush_v.price | money | json }},
            "formatted_rush_compare_at": {%- if pkg3_rush_v.compare_at_price > pkg3_rush_v.price -%}{{ pkg3_rush_v.compare_at_price | money | json }}{%- else -%}""{%- endif -%}
            {%- else -%}
            ,"rush_id": null,
            "rush_price": null,
            "formatted_rush_price": ""
            {%- endif -%}
          }
          {%- endif -%}
        },
        "product_variants": [
          {%- if std_product != blank -%}
            {
              "id": {{ std_default_v.id | json }},
              "price": {{ std_default_v.price | json }},
              "compare_at_price": {{ std_default_v.compare_at_price | json }},
              "formatted_price": {{ std_default_v.price | money | json }},
              "formatted_compare_at": {%- if std_default_v.compare_at_price > std_default_v.price -%}{{ std_default_v.compare_at_price | money | json }}{%- else -%}""{%- endif -%}
            }
          {%- endif -%}
          {%- if pro_product != blank -%}
            ,{
              "id": {{ pro_default_v.id | json }},
              "price": {{ pro_default_v.price | json }},
              "compare_at_price": {{ pro_default_v.compare_at_price | json }},
              "formatted_price": {{ pro_default_v.price | money | json }},
              "formatted_compare_at": {%- if pro_default_v.compare_at_price > pro_default_v.price -%}{{ pro_default_v.compare_at_price | money | json }}{%- else -%}""{%- endif -%}
            }
          {%- endif -%}
          {%- if pkg3_product != blank -%}
            ,{
              "id": {{ pkg3_default_v.id | json }},
              "price": {{ pkg3_default_v.price | json }},
              "compare_at_price": {{ pkg3_default_v.compare_at_price | json }},
              "formatted_price": {{ pkg3_default_v.price | money | json }},
              "formatted_compare_at": {%- if pkg3_default_v.compare_at_price > pkg3_default_v.price -%}{{ pkg3_default_v.compare_at_price | money | json }}{%- else -%}""{%- endif -%}
            }
          {%- endif -%}
        ],
        "rush_variant": {
          {%- if section.settings.rush_order_product != blank -%}
            {%- assign rush_v = section.settings.rush_order_product.selected_or_first_available_variant -%}
            "id": {{ rush_v.id | json }},
            "price": {{ rush_v.price | json }},
            "formatted_price": {{ rush_v.price | money | json }}
          {%- endif -%}
        }
      }
    </script>

    <!-- Bot Protection: Honeypot -->
    <div
      class="csb-hp-field"
      style="display:none; visibility:hidden; position:absolute; top:-9999px; left:-9999px;"
      aria-hidden="true"
    >
      <label for="csb-website-hp">Leave this field blank</label>
      <input
        type="text"
        id="csb-website-hp"
        name="website_url"
        data-csb-field="hp_website"
        tabindex="-1"
        autocomplete="off"
      >
    </div>
    {%- if heading_text != blank or subheading_text != blank -%}
      <div class="csb-card-top-header">
        {%- if heading_text != blank -%}
          <h1 class="csb-main-title">{{ heading_text }}</h1>
        {%- endif -%}
        {%- if subheading_text != blank -%}
          <p class="csb-main-subtitle">{{ subheading_text }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}

    <!-- Progress Bar -->
    <div class="csb-progress-wrap" data-csb-progress-wrap>
      <!-- Section 1 (Steps 1-4): Step X of 4 -->
      <div class="csb-progress-section-1" data-csb-section-1-bar>
        <div class="csb-progress-row">
          <span data-csb-step-label>Step 1 of 4</span>
          <span data-csb-percent-label>0% Complete</span>
        </div>
        <div class="csb-progress-track">
          <div class="csb-progress-fill" data-csb-progress-fill style="width: 0%;"></div>
        </div>
      </div>

      <!-- Section 2 & 3 (Steps 5-8): Stage Bar (Create - Preview - Unlock Song) -->
      <div class="csb-stage-bar" data-csb-stage-bar hidden>
        <div class="csb-stage-item" data-csb-stage="1">
          <span class="csb-stage-icon">✓</span>
          <span class="csb-stage-text">Create</span>
        </div>
        <div class="csb-stage-line" data-csb-stage-line="1"></div>
        <div class="csb-stage-item" data-csb-stage="2">
          <span class="csb-stage-icon">2</span>
          <span class="csb-stage-text">Preview</span>
        </div>
        <div class="csb-stage-line" data-csb-stage-line="2"></div>
        <div class="csb-stage-item" data-csb-stage="3">
          <span class="csb-stage-icon">3</span>
          <span class="csb-stage-text">Unlock Song</span>
        </div>
      </div>
    </div>

    <div class="csb-steps-container">
      <!-- STEP 1: Occasion -->
      <section class="csb-step" data-csb-step="1">
        <div class="csb-step-head">
          <h2>{{ section.settings.step1_title | default: "What's the occasion?" }}</h2>
          <p>{{ section.settings.step1_subtitle | default: 'Select the event or reason for your custom song.' }}</p>
        </div>
        <div class="csb-pill-group csb-center" data-csb-occasions>
          <div class="csb-loading-text">Loading occasions...</div>
        </div>
        <div class="csb-narrow csb-gap-top" data-csb-occasion-other-wrap hidden>
          <label class="csb-label">
            {{- section.settings.step1_other_label | default: 'Please specify your occasion' -}}
          </label>
          <input
            type="text"
            class="csb-input"
            placeholder="{{ section.settings.step1_other_placeholder | default: "e.g. Housewarming, New Job, Just Because..." }}"
            data-csb-field="customOccasion"
          >
        </div>
      </section>

      <!-- STEP 2: For Whom -->
      <section class="csb-step" data-csb-step="2" hidden>
        <div class="csb-step-head">
          <h2>{{ section.settings.step2_title | default: 'Who is this song for?' }}</h2>
          <p>{{ section.settings.step2_subtitle | default: 'Enter the name(s) that should be in the song.' }}</p>
        </div>
        <div class="csb-narrow">
          <div data-csb-recipients-wrap class="csb-recipients-wrap">
            <!-- Dynamically populated by JS -->
          </div>
          <button type="button" class="csb-btn-outline csb-gap-top" data-csb-add-recipient>+ Add another person</button>
        </div>
      </section>

      <!-- STEP 3: Creation Method & Story -->
      <section class="csb-step" data-csb-step="3" hidden>
        <div class="csb-step-head">
          <h2>{{ section.settings.step3_title | default: 'How would you like to provide your song?' }}</h2>
        </div>
        <div class="csb-medium">
          <div class="csb-method-grid">
            <button type="button" class="csb-method-card" data-csb-method="write_for_us">
              <span class="csb-method-title">
                {{- section.settings.step3_method1_title | default: "We'll write the lyrics" -}}
              </span>
              <span class="csb-method-desc">
                {{-
                  section.settings.step3_method1_desc
                  | default: "Tell us your story and we'll turn it into song lyrics."
                -}}
              </span>
            </button>
            <button type="button" class="csb-method-card" data-csb-method="own_lyrics">
              <span class="csb-method-title">
                {{- section.settings.step3_method2_title | default: 'I have my own lyrics' -}}
              </span>
              <span class="csb-method-desc">
                {{-
                  section.settings.step3_method2_desc
                  | default: "Paste your lyrics and we'll turn them into a professional song."
                -}}
              </span>
            </button>
          </div>

          <!-- write_for_us panel -->
          <div data-csb-panel="write_for_us" hidden>
            <div class="csb-story-head-row" style="display: flex; justify-content: space-between; align-items: flex-end; margin-bottom: 6px; flex-wrap: wrap; gap: 8px;">
              <div>
                <label class="csb-label" style="margin-bottom: 2px;">
                  {{- section.settings.step3_story_label | default: 'What makes this song special?' -}}
                </label>
                <p class="csb-hint" style="margin: 0;">
                  {{
                    section.settings.step3_story_hint
                    | default: 'Include how you met, memories, nicknames, hobbies, character traits...'
                  }}
                </p>
              </div>
              {%- assign current_iso = request.locale.iso_code | downcase -%}
              <div class="csb-lang-select-pill" style="display: flex; align-items: center; gap: 6px; background: #f3f4f6; padding: 6px 12px; border-radius: 10px; border: 1px solid #e5e7eb;">
                <span style="font-size: 0.8rem; font-weight: 600; color: #4b5563; white-space: nowrap;">
                  {%- if current_iso contains 'nl' -%}Taal:{%- else -%}Language:{%- endif -%}
                </span>
                <select data-csb-field="lyricsLanguage" class="csb-select" style="border: none; background: transparent; font-size: 0.875rem; font-weight: 600; color: #111827; cursor: pointer; padding: 0 4px; outline: none;">
                  <option value="English" {% if current_iso contains 'en' or current_iso == blank %}selected{% endif %}>🇬🇧 English</option>
                  <option value="Dutch" {% if current_iso contains 'nl' %}selected{% endif %}>🇳🇱 Dutch (Nederlands)</option>
                  <option value="German" {% if current_iso contains 'de' %}selected{% endif %}>🇩🇪 German (Deutsch)</option>
                  <option value="French" {% if current_iso contains 'fr' %}selected{% endif %}>🇫🇷 French (Français)</option>
                  <option value="Spanish" {% if current_iso contains 'es' %}selected{% endif %}>🇪🇸 Spanish (Español)</option>
                  <option value="Italian" {% if current_iso contains 'it' %}selected{% endif %}>🇮🇹 Italian (Italiano)</option>
                </select>
              </div>
            </div>

            <textarea
              class="csb-textarea"
              rows="6"
              placeholder="{{ section.settings.step3_story_placeholder | default: "We met at a coffee shop in 2018. She loves hiking and reading..." }}"
              data-csb-field="storyText"
            ></textarea>

            <!-- Generate action row (Shown before lyrics are generated) -->
            <div data-csb-generate-row style="margin-top: 14px;">
              <button type="button" class="csb-btn-primary" data-csb-generate-lyrics style="width: 100%; height: 48px; border-radius: 12px; font-size: 1rem; font-weight: 600;">
                <span class="csb-spinner" data-csb-lyrics-spinner hidden></span>
                <span data-csb-generate-lyrics-label>✨ Generate Lyrics</span>
              </button>
              <p class="csb-error-text" data-csb-lyrics-error hidden style="margin-top: 10px; padding: 10px 14px; background: #fef2f2; border: 1px solid #fecaca; border-radius: 8px; color: #dc2626; font-size: 0.875rem; font-weight: 500;"></p>
            </div>

            <!-- Generated lyrics variations (Appears cleanly below textarea) -->
            <div data-csb-lyrics-variations hidden class="csb-gap-top">
              <label class="csb-label csb-success-text">✓ Lyrics generated!</label>
              <p class="csb-lyrics-instruction" style="margin-bottom: 12px;">
                ✨
                {{
                  section.settings.step3_lyrics_instruction
                  | default: "Your lyrics are ready! Please check your lyrics below and edit if needed, then click 'Next Step' below to continue."
                }}
              </p>
              <div class="csb-variations-grid" data-csb-variations-grid></div>
            </div>
          </div>

          <!-- own_lyrics panel -->
          <div data-csb-panel="own_lyrics" hidden>
            <label class="csb-label">
              {{- section.settings.step3_own_lyrics_label | default: 'Paste your lyrics below' -}}
            </label>
            <textarea
              class="csb-textarea"
              rows="8"
              placeholder="Verse 1:&#10;Your lyrics here...&#10;&#10;Chorus:&#10;The chorus..."
              data-csb-field="ownLyrics"
            ></textarea>
          </div>
        </div>
      </section>

      <!-- STEP 4: Music Style (Moved before Email) -->
      <section class="csb-step" data-csb-step="4" hidden>
        <div class="csb-step-head">
          <h2>{{ section.settings.step6_title | default: 'Choose your style' }}</h2>
          <p>{{ section.settings.step6_subtitle | default: 'Pick the genre, voice, and mood for your song.' }}</p>
        </div>
        <div data-csb-style-groups>
          <div class="csb-loading-text csb-center">Loading style options...</div>
        </div>
      </section>

      <!-- STEP 5: Email (Unlock Free Demo) -->
      <section class="csb-step" data-csb-step="5" hidden>
        <div class="csb-step-head">
          <h2>{{ section.settings.step5_title | default: 'Where should we send it?' }}</h2>
          <p>{{ section.settings.step5_subtitle | default: 'Demo songs can be played instantly in the next step!' }}</p>
        </div>
        <div class="csb-narrow csb-gap-top-lg">
          <div class="csb-demo-lock-box" data-csb-lock-box>
            <div class="csb-demo-lock-icon" data-csb-lock-icon>
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                style="width: 1.5rem; height: 1.5rem;"
              >
                <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path data-csb-lock-shackle d="M7 11V7a5 5 0 0 1 10 0v4"></path>
              </svg>
            </div>
            <div class="csb-demo-lock-text">
              {% assign lock_text = section.settings.step5_lock_text
                | default: "Unlock Your Free Demo 🎶\nWe'll email your completed songs as soon as they're finished."
              %}
              {{ lock_text | newline_to_br }}
            </div>
          </div>

          <label class="csb-label csb-gap-top">Your Email Address</label>
          <input type="email" class="csb-input" placeholder="you@email.com" data-csb-field="email">
          <p class="csb-error-text csb-gap-top" data-csb-email-error hidden></p>

          <div class="csb-social-proof">
            <p>{{ section.settings.step5_social_proof1 | default: '4.9 / ⭐⭐⭐⭐⭐ - thousands of songs created' }}</p>
            <p>{{ section.settings.step5_social_proof2 | default: 'No spam, no newsletter — just your song.' }}</p>
          </div>

          <!-- Cloudflare Turnstile Widget -->
          <div class="csb-turnstile-wrap csb-gap-top" data-csb-turnstile-wrap hidden>
            <div
              class="cf-turnstile"
              data-sitekey="{{ section.settings.turnstile_site_key | default: 'YOUR_TURNSTILE_SITEKEY' }}"
              data-callback="onTurnstileSuccess"
            ></div>
          </div>
        </div>
      </section>

      <!-- STEP 6: Generating Music -->
      <section class="csb-step" data-csb-step="6" hidden>
        <div class="csb-generating" data-csb-generating-ok>
          <div class="csb-spinner-lg"></div>
          <h2>Composing your melody...</h2>
          <p>
            We are generating two unique versions of your song. This usually takes 1-3 minutes, occasionally longer.
          </p>
          <div class="csb-progress-track csb-progress-track-wide">
            <div class="csb-progress-fill" data-csb-gen-progress-fill style="width: 0%;"></div>
          </div>
          <p class="csb-percent-text" data-csb-gen-progress-text>0%</p>
        </div>
        <div class="csb-generating" data-csb-generating-error hidden>
          <div class="csb-error-icon">❌</div>
          <h2>Generation Failed</h2>
          <p class="csb-error-text" data-csb-gen-error-text></p>
          <button type="button" class="csb-btn-secondary" data-csb-gen-back>Go Back &amp; Try Again</button>
        </div>
      </section>

      <!-- STEP 7: Listen to Demos -->
      <section class="csb-step" data-csb-step="7" hidden>
        <div class="csb-step-head">
          <h2 data-csb-step7-title>{{ section.settings.step7_title | default: 'Listen to Your Song Preview' }}</h2>
          <p data-csb-tracks-count>
            {{
              section.settings.step7_subtitle
              | default: 'Choose your favorite. Your full song will be unlocked after checkout.'
            }}
          </p>
        </div>
        <div class="csb-tracks-grid" data-csb-tracks-grid></div>
      </section>

      <!-- STEP 8: Choose Package (Final Step) -->
      <section class="csb-step" data-csb-step="8" hidden>
        <div class="csb-step-head">
          <h2>{{ section.settings.step8_title | default: 'Choose Your Package' }}</h2>
        </div>
        <div class="csb-packages-grid" data-csb-packages-grid>
          {%- if std_product != blank -%}
            <div
              class="csb-package-card is-selected"
              data-csb-package-card="standard"
              data-package-id="standard"
              data-variant-id="{{ std_default_v.id }}"
              {% if std_rush_v != blank %}
                data-rush-variant-id="{{ std_rush_v.id }}" data-rush-price="{{ std_rush_v.price | money }}"
              {% endif %}
              data-price="{{ std_default_v.price | money }}"
            >
              <div class="csb-package-body">
                <h3 class="csb-package-title">🔒 Unlock Song - Standard</h3>
                <div class="csb-package-song-length">Full song length: ~2-3 min</div>
                <div class="csb-package-features">
                  <div class="csb-package-features-label">📦 What's included?</div>
                  <ul>
                    <li>Unlock your Full 2-4 min song</li>
                    <li>Delivered in 24-48 Hours</li>
                    <li>High Quality Personal Song</li>
                    <li>Not Quite Right? We'll Revise</li>
                    <li>One-time payment, no subscription</li>
                  </ul>
                </div>
                <div class="csb-package-price-wrap">
                  {%- if std_default_v.compare_at_price > std_default_v.price -%}
                    <span class="csb-package-original-price">{{ std_default_v.compare_at_price | money }}</span>
                    {%- assign std_savings = std_default_v.compare_at_price | minus: std_default_v.price -%}
                    {%- assign std_discount = std_savings
                      | times: 100.0
                      | divided_by: std_default_v.compare_at_price
                      | round
                    -%}
                    <div class="csb-package-price" data-csb-package-price>{{ std_default_v.price | money }}</div>
                    {%- if std_discount > 0 -%}
                      <span class="csb-package-discount-badge">{{ std_discount }}% OFF</span>
                    {%- endif -%}
                  {%- else -%}
                    <div class="csb-package-price" data-csb-package-price>{{ std_default_v.price | money }}</div>
                  {%- endif -%}
                </div>
              </div>
            </div>
          {%- endif -%}

          {%- if pro_product != blank -%}
            <div
              class="csb-package-card"
              data-csb-package-card="pro"
              data-package-id="pro"
              data-variant-id="{{ pro_default_v.id }}"
              {% if pro_rush_v != blank %}
                data-rush-variant-id="{{ pro_rush_v.id }}" data-rush-price="{{ pro_rush_v.price | money }}"
              {% endif %}
              data-price="{{ pro_default_v.price | money }}"
            >
              <div class="csb-package-tag">Most Popular</div>
              <div class="csb-package-body">
                <h3 class="csb-package-title">🔒 Unlock Song - Pro</h3>
                <div class="csb-package-song-length">Full song length: ~2-3 min</div>
                <div class="csb-package-features">
                  <div class="csb-package-features-label">📦 What's included?</div>
                  <ul>
                    <li>Everything from standard</li>
                    <li>12-24 hour delivery</li>
                    <li>Custom Lyrics Included</li>
                    <li>Not Happy With the Full Song? Full Refund</li>
                    <li>One-time payment, no subscription</li>
                  </ul>
                </div>
                <div class="csb-package-price-wrap">
                  {%- if pro_default_v.compare_at_price > pro_default_v.price -%}
                    <span class="csb-package-original-price">{{ pro_default_v.compare_at_price | money }}</span>
                    {%- assign pro_savings = pro_default_v.compare_at_price | minus: pro_default_v.price -%}
                    {%- assign pro_discount = pro_savings
                      | times: 100.0
                      | divided_by: pro_default_v.compare_at_price
                      | round
                    -%}
                    <div class="csb-package-price" data-csb-package-price>{{ pro_default_v.price | money }}</div>
                    {%- if pro_discount > 0 -%}
                      <span class="csb-package-discount-badge">{{ pro_discount }}% OFF</span>
                    {%- endif -%}
                  {%- else -%}
                    <div class="csb-package-price" data-csb-package-price>{{ pro_default_v.price | money }}</div>
                  {%- endif -%}
                </div>
              </div>
            </div>
          {%- endif -%}

          {%- if pkg3_product != blank -%}
            <div
              class="csb-package-card"
              data-csb-package-card="pkg_1789041581797"
              data-package-id="pkg_1789041581797"
              data-variant-id="{{ pkg3_default_v.id }}"
              {% if pkg3_rush_v != blank %}
                data-rush-variant-id="{{ pkg3_rush_v.id }}" data-rush-price="{{ pkg3_rush_v.price | money }}"
              {% endif %}
              data-price="{{ pkg3_default_v.price | money }}"
            >
              <div class="csb-package-tag">Best Value</div>
              <div class="csb-package-body">
                <h3 class="csb-package-title">🔒 Unlock Pro + Spotify &amp; Apple Music</h3>
                <div class="csb-package-song-length">Full song length: ~2-3 min</div>
                <div class="csb-package-features">
                  <div class="csb-package-features-label">📦 What's included?</div>
                  <ul>
                    <li>Everything in Pro, Plus ↓</li>
                    <li>Your Song Published on Spotify</li>
                    <li>Your Song Published on Apple Music</li>
                  </ul>
                </div>
                <div class="csb-package-price-wrap">
                  {%- if pkg3_default_v.compare_at_price > pkg3_default_v.price -%}
                    <span class="csb-package-original-price">{{ pkg3_default_v.compare_at_price | money }}</span>
                    {%- assign pkg3_savings = pkg3_default_v.compare_at_price | minus: pkg3_default_v.price -%}
                    {%- assign pkg3_discount = pkg3_savings
                      | times: 100.0
                      | divided_by: pkg3_default_v.compare_at_price
                      | round
                    -%}
                    <div class="csb-package-price" data-csb-package-price>{{ pkg3_default_v.price | money }}</div>
                    {%- if pkg3_discount > 0 -%}
                      <span class="csb-package-discount-badge">{{ pkg3_discount }}% OFF</span>
                    {%- endif -%}
                  {%- else -%}
                    <div class="csb-package-price" data-csb-package-price>{{ pkg3_default_v.price | money }}</div>
                  {%- endif -%}
                </div>
              </div>
            </div>
          {%- endif -%}
        </div>

        <!-- Upsells Container (Dynamic from backend API + fallback) -->
        <div class="csb-upsells-container csb-gap-top space-y-3" data-csb-upsells-container>
          {%- if section.settings.rush_order_product != blank or std_rush_v != blank or pro_rush_v != blank -%}
            <div class="csb-rush-order-box" data-csb-rush-box>
              <label class="csb-checkbox-row csb-checkbox-rush">
                <input type="checkbox" class="csb-upsell-checkbox" data-csb-field="rushOrder">
                <div class="csb-rush-order-info">
                  <span class="csb-rush-order-title" data-csb-rush-title>
                    {{- section.settings.rush_order_title | default: 'Rush My Order' -}}
                  </span>
                  <span class="csb-rush-order-text" data-csb-rush-desc>
                    {{- section.settings.rush_order_text | default: 'Order delivered in 30 minutes' -}}
                  </span>
                </div>
                <span class="csb-rush-order-price" data-csb-rush-price>
                  {%- if section.settings.rush_order_product != blank -%}
                    {{ section.settings.rush_order_product.price | money }}
                  {%- elsif std_rush_v != blank and std_default_v != blank -%}
                    {%- assign diff_price = std_rush_v.price | minus: std_default_v.price -%}
                    {%- if diff_price > 0 -%}
                      +{{ diff_price | money }}
                    {%- else -%}
                      {{ std_rush_v.price | money }}
                    {%- endif -%}
                  {%- endif -%}
                </span>
              </label>
            </div>
          {%- endif -%}
        </div>
      </section>
    </div>

    <!-- Purchased View -->
    <div class="csb-purchased-view" data-csb-purchased-view hidden>
      <div class="csb-purchased-icon">🎉</div>
      <h2 class="csb-main-title">Music Already Purchased</h2>
      <p class="csb-main-subtitle">You have already successfully purchased this custom song.</p>
    </div>

    <!-- Validation Error Container (Always visible above Next Step button) -->
    <div class="csb-nav-error-wrap" data-csb-nav-error hidden></div>

    <!-- Navigation -->
    <div class="csb-nav" data-csb-nav>
      <button type="button" class="csb-btn-back" data-csb-back>Back</button>
      <div class="csb-nav-right">
        <button type="button" class="csb-btn-secondary csb-btn-regen-nav" data-csb-generate-lyrics-again hidden>
          <span class="csb-spinner" data-csb-lyrics-spinner-2 hidden></span>
          <span data-csb-regen-label>↻ Regenerate Lyrics</span>
        </button>
        <button type="button" class="csb-btn-secondary csb-btn-regen-nav" data-csb-regen-songs hidden>
          ↻ Regenerate Songs
        </button>
        <button type="button" class="csb-btn-next" data-csb-next>Next</button>
        <button type="button" class="csb-btn-checkout" data-csb-checkout hidden>
          <span class="csb-spinner" data-csb-checkout-spinner hidden></span>
          <span data-csb-checkout-label>Checkout &amp; Pay</span>
        </button>
      </div>
    </div>

    <!-- Trust Subtext below Checkout -->
    <div class="csb-trust-subtext" data-csb-trust-subtext hidden>
      Secure payment · One-time payment · No subscription
    </div>

    <!-- Lyrics Regeneration Modal -->
    <div class="csb-modal-overlay" data-csb-lyrics-modal hidden>
      <div class="csb-modal">
        <div class="csb-modal-header">
          <h3>Regenerate Lyrics?</h3>
          <button type="button" class="csb-modal-close" data-csb-lyrics-modal-close aria-label="Close">&times;</button>
        </div>
        <div class="csb-modal-body">
          <div class="csb-modal-alert">
            <span>⚠️ You updated: </span>
            <strong data-csb-lyrics-changed-fields>Occasion</strong>
          </div>
          <p class="csb-modal-text">Do you want to regenerate your song lyrics using your new choices?</p>
          <div class="csb-gap-top">
            <label class="csb-label">What makes this song special?</label>
            <p class="csb-hint">
              Include how you met, memories, nicknames, hobbies, character traits... (Make changes if you want to)
            </p>
            <textarea
              class="csb-textarea"
              rows="5"
              data-csb-modal-story-input
              placeholder="We met at a coffee shop in 2018..."
            ></textarea>
          </div>
        </div>
        <div class="csb-modal-footer csb-modal-footer-stacked">
          <button type="button" class="csb-btn-primary csb-btn-full" data-csb-lyrics-modal-yes>
            Yes, Regenerate Lyrics
          </button>
          <button type="button" class="csb-btn-secondary csb-btn-full" data-csb-lyrics-modal-no>
            No, Keep Current Lyrics
          </button>
        </div>
      </div>
    </div>

    <!-- Music Regeneration Modal -->
    <div class="csb-modal-overlay" data-csb-music-modal hidden>
      <div class="csb-modal">
        <div class="csb-modal-header">
          <h3>Regenerate Music?</h3>
          <button type="button" class="csb-modal-close" data-csb-music-modal-close aria-label="Close">&times;</button>
        </div>
        <div class="csb-modal-body">
          <div class="csb-modal-alert">
            <span>🎵 New Style Selected: </span>
            <strong data-csb-music-changed-style>Pop • Male Voice • Emotional</strong>
          </div>
          <p class="csb-modal-text">Do you want to regenerate your custom song with your new style selections?</p>
        </div>
        <div class="csb-modal-footer csb-modal-footer-stacked">
          <button type="button" class="csb-btn-primary csb-btn-full" data-csb-music-modal-yes>
            Yes, Regenerate Music
          </button>
          <button type="button" class="csb-btn-secondary csb-btn-full" data-csb-music-modal-no>
            No, Keep Existing Songs
          </button>
        </div>
      </div>
    </div>

    <!-- Page Refresh / Resume Confirmation Modal -->
    <div class="csb-modal-overlay" data-csb-refresh-modal hidden>
      <div class="csb-modal">
        <div class="csb-modal-header">
          <h3>Continue your song?</h3>
          <button type="button" class="csb-modal-close" data-csb-refresh-modal-close aria-label="Close">&times;</button>
        </div>
        <div class="csb-modal-body">
          <p class="csb-modal-text">
            We found a song you were working on. Would you like to keep working on your current song or start fresh?
          </p>
        </div>
        <div class="csb-modal-footer csb-modal-footer-stacked">
          <button type="button" class="csb-btn-primary csb-btn-full" data-csb-refresh-modal-keep>
            Keep Current Song
          </button>
          <button type="button" class="csb-btn-secondary csb-btn-full" data-csb-refresh-modal-new>
            Start New Song
          </button>
        </div>
      </div>
    </div>

    <!-- Cart Conflict / Multiple Songs Modal -->
    <div class="csb-modal-overlay" data-csb-cart-modal hidden>
      <div class="csb-modal">
        <div class="csb-modal-header">
          <h3>Multiple Songs in Cart</h3>
          <button type="button" class="csb-modal-close" data-csb-cart-modal-close aria-label="Close">&times;</button>
        </div>
        <div class="csb-modal-body">
          <p class="csb-modal-text">Do you want to keep your multiple songs or do you want to view your cart?</p>
        </div>
        <div class="csb-modal-footer csb-modal-footer-stacked">
          <button type="button" class="csb-btn-primary csb-btn-full" data-csb-cart-modal-keep>
            Keep multiple songs
          </button>
          <button type="button" class="csb-btn-secondary csb-btn-full" data-csb-cart-modal-view>View your cart</button>
        </div>
      </div>
    </div>
  </div>
</div>

<script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
<script src="{{ 'custom-song-builder.js' | asset_url }}" defer="defer"></script>

{% schema %}
