    },
    {
      "type": "text",
      "id": "step5_social_proof2",
      "label": "Social Proof Line 2",
      "default": "No spam, no newsletter — just your song."
    },
    {
      "type": "header",
      "content": "Step 6: Style"
    },
    { "type": "text", "id": "step6_title", "label": "Title", "default": "Choose your style" },
    {
      "type": "text",
      "id": "step6_subtitle",
      "label": "Subtitle",
      "default": "Pick the genre, voice, and mood for your song."
    },
    {
      "type": "text",
      "id": "style_genre_error",
