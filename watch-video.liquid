  }
  .cwv-main-subtitle {
    font-size: 13px;
    color: #64748b;
    margin: 0;
  }

  .cwv-action-bar {
    display: flex;
    gap: 10px;
    align-items: center;
    flex-wrap: wrap;
  }

  /* 3. DETAILS / ORDER METADATA BOX */
  .cwv-details-box {
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 16px;
    padding: 20px 24px;
    margin-top: 10px;
  }
  .cwv-details-header {
    display: flex;
    justify-content: space-between;
