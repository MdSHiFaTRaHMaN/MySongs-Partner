    background: #ecfdf5;
    padding: 4px 10px;
    border-radius: 9999px;
  }

  .cwv-meta-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 14px;
  }
  @media (min-width: 640px) {
    .cwv-meta-grid {
      grid-template-columns: 1fr 1fr;
    }
  }
  .cwv-meta-item {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .cwv-meta-label {
    font-size: 12px;
    color: #64748b;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }
  .cwv-meta-val {
    font-size: 14px;
    color: #1e293b;
  }
  .cwv-link-support {
    color: var(--cwv-brand, #ff5b00);
    text-decoration: none;
    font-weight: 500;
  }
  .cwv-link-support:hover {
    text-decoration: underline;
  }

  .cwv-toast {
    position: fixed;
    bottom: 24px;
    right: 24px;
    background: #0f172a;
    color: #ffffff;
    padding: 12px 20px;
    border-radius: 12px;
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 14px;
    font-weight: 500;
    box-shadow: 0 10px 25px rgba(0, 0, 0, 0.2);
    transform: translateY(100px);
    opacity: 0;
    transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    z-index: 9999;
  }
  .cwv-toast.show {
    transform: translateY(0);
    opacity: 1;
  }
  .cwv-toast-icon {
    width: 18px;
    height: 18px;
    color: #10b981;
  }
</style>

<script>
  (function () {
    const urlParams = new URLSearchParams(window.location.search);
    const videoUrl = urlParams.get('videoUrl') || urlParams.get('url') || urlParams.get('streamVideoUrl') || '';
    const downloadUrl = urlParams.get('directDownloadUrl') || urlParams.get('downloadUrl') || videoUrl;
    const targetEmail = (urlParams.get('email') || urlParams.get('e') || '').trim();
    const customerName = (
      urlParams.get('name') ||
      urlParams.get('customerName') ||
      urlParams.get('first_name') ||
      ''
    ).trim();
    const orderNumber = urlParams.get('order') || urlParams.get('shopifyOrderId') || urlParams.get('orderNumber') || '';
    const videoTitle = urlParams.get('title') || '';
    const packageType = urlParams.get('package') || '';
    const posterParam =
      urlParams.get('poster') ||
      urlParams.get('posterUrl') ||
      urlParams.get('thumbnail') ||
      urlParams.get('thumb') ||
      '';

    const loadingState = document.getElementById('cwv-loading-state');
    const missingState = document.getElementById('cwv-missing-state');
    const playerWorkspace = document.getElementById('cwv-player-workspace');

    if (loadingState) loadingState.style.display = 'none';

    if (!videoUrl) {
      if (missingState) missingState.style.display = 'block';
      return;
    }

    if (playerWorkspace) {
      playerWorkspace.style.display = 'block';
    }

    const videoTitleEl = document.getElementById('cwv-video-title');
    if (videoTitleEl && videoTitle) videoTitleEl.textContent = videoTitle;

    const subtitleEl = document.getElementById('cwv-video-subtitle');
    if (subtitleEl && customerName) {
      subtitleEl.innerHTML =
        'Personalized for <strong class="cwv-text-highlight">' +
        customerName +
        '</strong> • Ready to stream & download';
    }

    const metaCustomerEl = document.getElementById('cwv-meta-customer-info');
    if (metaCustomerEl) {
      if (customerName && targetEmail) {
        metaCustomerEl.textContent = customerName + ' (' + targetEmail + ')';
      } else if (targetEmail) {
        metaCustomerEl.textContent = targetEmail;
      } else if (customerName) {
        metaCustomerEl.textContent = customerName;
      }
    }

    const metaOrderEl = document.getElementById('cwv-meta-order-number');
    if (metaOrderEl && orderNumber) {
      metaOrderEl.textContent = orderNumber.startsWith('#') ? orderNumber : '#' + orderNumber;
    } else if (metaOrderEl) {
      const wrap = document.getElementById('cwv-meta-order-wrap');
      if (wrap && !orderNumber) wrap.style.display = 'none';
    }

    const metaPkgEl = document.getElementById('cwv-meta-pkg-name');
    if (metaPkgEl && packageType) {
      metaPkgEl.textContent = packageType;
    } else if (metaPkgEl && !packageType) {
      const pkgWrap = document.getElementById('cwv-meta-pkg-wrap');
      if (pkgWrap) pkgWrap.style.display = 'none';
    }

    const downloadBtn = document.getElementById('cwv-download-btn');
    if (downloadBtn && downloadUrl) {
      downloadBtn.href = downloadUrl;
    }

    const video = document.getElementById('cwv-video-element');
    const videoFrame = document.getElementById('cwv-video-frame');
    const bigPlayBtn = document.getElementById('cwv-big-play-btn');
    const playBtn = document.getElementById('cwv-ctrl-play');
    const iconPlay = playBtn?.querySelector('.cwv-icon-play');
    const iconPause = playBtn?.querySelector('.cwv-icon-pause');
    const timeCurrent = document.getElementById('cwv-time-current');
    const timeTotal = document.getElementById('cwv-time-total');
    const progressContainer = document.getElementById('cwv-progress-container');
    const progressFilled = document.getElementById('cwv-progress-filled');
    const progressBuffered = document.getElementById('cwv-progress-buffered');
    const progressHover = document.getElementById('cwv-progress-hover');
    const progressTooltip = document.getElementById('cwv-progress-tooltip');
    const muteBtn = document.getElementById('cwv-ctrl-mute');
    const iconVol = muteBtn?.querySelector('.cwv-icon-vol');
    const iconVolMute = muteBtn?.querySelector('.cwv-icon-vol-mute');
    const volumeSlider = document.getElementById('cwv-volume-slider');
    const speedBtn = document.getElementById('cwv-ctrl-speed');
    const speedMenu = document.getElementById('cwv-speed-menu');
    const fullscreenBtn = document.getElementById('cwv-ctrl-fullscreen');

    const formatTime = (secs) => {
      if (isNaN(secs) || secs < 0) return '0:00';
      const m = Math.floor(secs / 60);
      const s = Math.floor(secs % 60);
      return m + ':' + (s < 10 ? '0' : '') + s;
    };

    if (video) {
      if (posterParam) {
        video.poster = posterParam;
      }

      // Append media fragment #t=0.5 so HTML5 video decoders render the 0.5s frame on load
      const videoSrcWithFragment = videoUrl.indexOf('#') === -1 ? videoUrl + '#t=0.5' : videoUrl;
      video.src = videoSrcWithFragment;
      video.load();

      let hasStartedPlayingOnce = false;
      let firstSceneRendered = false;

      const updateDurationUI = () => {
        if (video.duration && !isNaN(video.duration) && isFinite(video.duration) && video.duration > 0) {
          const durFormatted = formatTime(video.duration);
          if (timeTotal) timeTotal.textContent = durFormatted;
        }
      };

      // Try capturing snapshot poster via canvas (works when video has CORS / same-origin)
      const captureCanvasPoster = () => {
        if (video.poster && !video.poster.startsWith('blob:')) return;
        try {
          if (video.videoWidth && video.videoHeight) {
            const canvas = document.createElement('canvas');
            canvas.width = Math.min(video.videoWidth, 1280);
            canvas.height = Math.min(video.videoHeight, 720);
            const ctx = canvas.getContext('2d');
            ctx.drawImage(video, 0, 0, canvas.width, canvas.height);
            const posterData = canvas.toDataURL('image/jpeg', 0.85);
            if (posterData && posterData.length > 500) {
              video.poster = posterData;
            }
          }
        } catch (err) {
          // CORS fallback: the video element's currentTime seek already paints the frame on screen
        }
      };

      // Automatically seek to 0.5s on load to render the first video scene instead of a black screen
      const initFirstVideoScene = () => {
        updateDurationUI();
        if (!firstSceneRendered && !hasStartedPlayingOnce) {
          firstSceneRendered = true;
          if (video.currentTime === 0) {
            try {
              video.currentTime = 0.5;
            } catch (e) {}
          }
        }
      };

      video.addEventListener('loadedmetadata', initFirstVideoScene);
      video.addEventListener('loadeddata', () => {
        initFirstVideoScene();
        captureCanvasPoster();
      });
      video.addEventListener('canplay', () => {
        initFirstVideoScene();
        captureCanvasPoster();
      });
      video.addEventListener('durationchange', updateDurationUI);
      video.addEventListener('seeked', () => {
        if (!hasStartedPlayingOnce) {
          captureCanvasPoster();
        }
      });

      // Quick polling fallback to ensure duration displays immediately across all browsers
      let durationCheckCount = 0;
      const durationInterval = setInterval(() => {
        durationCheckCount++;
        updateDurationUI();
        if (video.duration || durationCheckCount > 20) {
          clearInterval(durationInterval);
        }
      }, 200);

      const togglePlay = () => {
        if (video.paused || video.ended) {
          // If video was parked at 0.5s for initial thumbnail preview, start from 0:00 for the viewer
          if (!hasStartedPlayingOnce && video.currentTime > 0 && video.currentTime <= 0.8) {
            video.currentTime = 0;
          }
          hasStartedPlayingOnce = true;
          video.play().catch((err) => {
            console.warn('Autoplay or play prevented:', err);
          });
        } else {
          video.pause();
        }
      };

      if (bigPlayBtn)
        bigPlayBtn.addEventListener('click', (e) => {
          e.stopPropagation();
          togglePlay();
        });
      if (videoFrame) videoFrame.addEventListener('click', togglePlay);
      if (playBtn) playBtn.addEventListener('click', togglePlay);

      video.addEventListener('play', () => {
        videoFrame?.classList.add('playing');
        if (iconPlay) iconPlay.style.display = 'none';
        if (iconPause) iconPause.style.display = 'block';
      });

      video.addEventListener('pause', () => {
        videoFrame?.classList.remove('playing');
        if (iconPlay) iconPlay.style.display = 'block';
        if (iconPause) iconPause.style.display = 'none';
      });

      video.addEventListener('ended', () => {
        videoFrame?.classList.remove('playing');
        if (iconPlay) iconPlay.style.display = 'block';
        if (iconPause) iconPause.style.display = 'none';
      });

      // Synchronous, non-laggy progress update during normal video playback
      video.addEventListener('timeupdate', () => {
        if (isScrubbing) return;
        if (timeCurrent) timeCurrent.textContent = formatTime(video.currentTime);
        if (progressFilled && video.duration) {
          const pct = (video.currentTime / video.duration) * 100;
          progressFilled.style.width = pct + '%';
        }
      });

      video.addEventListener('progress', () => {
        if (video.buffered.length > 0 && video.duration && progressBuffered) {
          const bufferedEnd = video.buffered.end(video.buffered.length - 1);
          const pct = (bufferedEnd / video.duration) * 100;
          progressBuffered.style.width = pct + '%';
        }
      });

      // REAL-TIME PROGRESS BAR SCRUBBING & HOVER PREVIEW
      let isScrubbing = false;
      let wasPlayingBeforeScrub = false;

      const getProgressPct = (e) => {
        if (!progressContainer) return 0;
        const rect = progressContainer.getBoundingClientRect();
        const clientX = e.touches && e.touches.length ? e.touches[0].clientX : e.clientX;
        const pos = (clientX - rect.left) / rect.width;
        return Math.max(0, Math.min(1, pos));
      };

      const updateSeekUI = (pct) => {
        if (progressFilled) progressFilled.style.width = pct * 100 + '%';
        if (video.duration && timeCurrent) {
          const previewTime = pct * video.duration;
          timeCurrent.textContent = formatTime(previewTime);
        }
      };

      const applySeek = (pct) => {
        if (!video.duration || isNaN(video.duration)) return;
        const targetTime = pct * video.duration;
        if (typeof video.fastSeek === 'function') {
          try {
            video.fastSeek(targetTime);
          } catch (err) {
            video.currentTime = targetTime;
          }
        } else {
          video.currentTime = targetTime;
        }
      };

      if (progressContainer) {
        // Hover preview
        progressContainer.addEventListener('mousemove', (e) => {
          if (!video.duration) return;
          const rect = progressContainer.getBoundingClientRect();
          const pos = Math.max(0, Math.min(1, (e.clientX - rect.left) / rect.width));

          if (progressHover) {
            progressHover.style.width = pos * 100 + '%';
          }

          if (progressTooltip) {
            const hoverTime = pos * video.duration;
            progressTooltip.textContent = formatTime(hoverTime);
            progressTooltip.style.left = pos * 100 + '%';
            progressTooltip.style.opacity = '1';
            progressTooltip.style.visibility = 'visible';
          }

          if (isScrubbing) {
            updateSeekUI(pos);
            applySeek(pos);
          }
        });

        progressContainer.addEventListener('mouseleave', () => {
          if (progressHover) progressHover.style.width = '0%';
          if (progressTooltip && !isScrubbing) {
            progressTooltip.style.opacity = '0';
            progressTooltip.style.visibility = 'hidden';
          }
        });

        const startScrubbing = (e) => {
          if (!video.duration) return;
          isScrubbing = true;
          progressContainer.classList.add('scrubbing');
          wasPlayingBeforeScrub = !video.paused;
          if (wasPlayingBeforeScrub) video.pause();

          const pct = getProgressPct(e);
          updateSeekUI(pct);
          applySeek(pct);

          if (progressTooltip) {
            progressTooltip.textContent = formatTime(pct * video.duration);
            progressTooltip.style.left = pct * 100 + '%';
            progressTooltip.style.opacity = '1';
            progressTooltip.style.visibility = 'visible';
          }
        };

        progressContainer.addEventListener('mousedown', (e) => {
          startScrubbing(e);
        });

        progressContainer.addEventListener(
          'touchstart',
          (e) => {
            startScrubbing(e);
          },
          { passive: true }
        );

        // Global listeners for smooth dragging outside the bar
        window.addEventListener('mousemove', (e) => {
          if (!isScrubbing || !video.duration) return;
          const pct = getProgressPct(e);
          updateSeekUI(pct);
          applySeek(pct);
          if (progressTooltip) {
            progressTooltip.textContent = formatTime(pct * video.duration);
            progressTooltip.style.left = pct * 100 + '%';
          }
        });

        window.addEventListener(
          'touchmove',
          (e) => {
            if (!isScrubbing || !video.duration) return;
            const pct = getProgressPct(e);
            updateSeekUI(pct);
            applySeek(pct);
            if (progressTooltip) {
              progressTooltip.textContent = formatTime(pct * video.duration);
              progressTooltip.style.left = pct * 100 + '%';
            }
          },
          { passive: true }
        );

        const stopScrubbing = (e) => {
          if (!isScrubbing) return;
          isScrubbing = false;
          progressContainer.classList.remove('scrubbing');
          if (e) {
            const pct = getProgressPct(e);
            updateSeekUI(pct);
            applySeek(pct);
          }
          if (progressTooltip) {
            progressTooltip.style.opacity = '0';
            progressTooltip.style.visibility = 'hidden';
          }
          if (wasPlayingBeforeScrub) {
            video.play();
          }
        };

        window.addEventListener('mouseup', stopScrubbing);
        window.addEventListener('touchend', stopScrubbing);
      }

      if (muteBtn) {
        muteBtn.addEventListener('click', () => {
          video.muted = !video.muted;
          if (iconVol) iconVol.style.display = video.muted ? 'none' : 'block';
          if (iconVolMute) iconVolMute.style.display = video.muted ? 'block' : 'none';
          if (volumeSlider) volumeSlider.value = video.muted ? 0 : video.volume;
        });
      }

      if (volumeSlider) {
        volumeSlider.addEventListener('input', (e) => {
          video.volume = parseFloat(e.target.value);
          video.muted = video.volume === 0;
          if (iconVol) iconVol.style.display = video.muted ? 'none' : 'block';
          if (iconVolMute) iconVolMute.style.display = video.muted ? 'block' : 'none';
        });
      }

      if (speedBtn && speedMenu) {
        speedBtn.addEventListener('click', (e) => {
          e.stopPropagation();
          speedMenu.classList.toggle('open');
        });

        speedMenu.querySelectorAll('button').forEach((btn) => {
          btn.addEventListener('click', () => {
            const speed = parseFloat(btn.dataset.speed || '1.0');
            video.playbackRate = speed;
            speedBtn.textContent = speed + 'x';
            speedMenu.querySelectorAll('button').forEach((b) => b.classList.remove('active'));
            btn.classList.add('active');
            speedMenu.classList.remove('open');
          });
        });

        document.addEventListener('click', () => speedMenu.classList.remove('open'));
      }

      if (fullscreenBtn) {
        fullscreenBtn.addEventListener('click', () => {
          if (!document.fullscreenElement) {
            if (videoFrame.requestFullscreen) videoFrame.requestFullscreen();
            else if (video.webkitRequestFullscreen) video.webkitRequestFullscreen();
          } else {
            if (document.exitFullscreen) document.exitFullscreen();
          }
        });
      }

      document.addEventListener('keydown', (e) => {
        if (['INPUT', 'TEXTAREA'].includes(document.activeElement?.tagName)) return;
        if (e.code === 'Space' || e.code === 'KeyK') {
          e.preventDefault();
          togglePlay();
        } else if (e.code === 'KeyF') {
          e.preventDefault();
          fullscreenBtn?.click();
        } else if (e.code === 'KeyM') {
          e.preventDefault();
          muteBtn?.click();
        } else if (e.code === 'ArrowLeft' || e.code === 'KeyJ') {
          e.preventDefault();
          if (video.duration) {
            video.currentTime = Math.max(0, video.currentTime - 5);
          }
        } else if (e.code === 'ArrowRight' || e.code === 'KeyL') {
          e.preventDefault();
          if (video.duration) {
            video.currentTime = Math.min(video.duration, video.currentTime + 5);
          }
        }
      });
    }

    const shareBtn = document.getElementById('cwv-share-btn');
    const toast = document.getElementById('cwv-toast');
    const toastMsg = document.getElementById('cwv-toast-msg');

    const showToast = (msg) => {
      if (!toast) return;
      if (toastMsg) toastMsg.textContent = msg;
      toast.classList.add('show');
      setTimeout(() => toast.classList.remove('show'), 3500);
    };

    if (shareBtn) {
      shareBtn.addEventListener('click', () => {
        if (navigator.clipboard) {
          navigator.clipboard
            .writeText(window.location.href)
            .then(() => {
              showToast('Watch link copied to clipboard!');
            })
            .catch(() => {
              showToast('Watch link: ' + window.location.href);
            });
        } else {
          showToast('Watch link: ' + window.location.href);
        }
      });
    }
  })();
</script>

